{
  "name": "@lattefox/dev-config",
  "version": "1.0.3",
  "description": "Shared ESLint / Prettier / tsconfig / commitlint baseline for lattefox and personal projects",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lattefox/dev-config.git"
  },
  "exports": {
    "./eslint/react": "./eslint/react.js",
    "./eslint/nest": "./eslint/nest.js",
    "./prettier": "./prettier/index.js",
    "./commitlint": "./commitlint/index.js",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./tsconfig/nest.json": "./tsconfig/nest.json",
    "./knip/react": "./knip/react.js",
    "./knip/nest": "./knip/nest.js"
  },
  "files": [
    "eslint",
    "prettier",
    "commitlint",
    "tsconfig",
    "knip",
