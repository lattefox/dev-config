  "peerDependencies": {
    "eslint": "^9.20.0",
    "prettier": "^3.6.0",
    "typescript": ">=5.8.0"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
